@{
    ViewData["Title"] = "About Us";
}

<section class="py-5">
    <div class="container">

        <div class="text-center mb-5">
            <h1 class="fw-bold display-5">About PropCheck</h1>
            <p class="text-secondary fs-5">
                Professional Building Inspection Platform
            </p>
        </div>

        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <div class="row justify-content-center mb-5">
                    <div class="col-lg-9">
                        <div style="position:relative;width:100%;height:420px;overflow:hidden;border-radius:18px;border:1px solid #222;">
                            <video autoplay muted loop playsinline
                                   style="position:absolute;top:50%;left:50%;width:100%;height:100%;transform:translate(-50%,-50%);object-fit:cover;z-index:0;">
                                <source src="~/images/VideoIne.mp4" type="video/mp4">
                            </video>
                            <div style="position:absolute;inset:0;background:rgba(0,0,0,.15);z-index:1;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <h2 class="fw-bold mb-3">
                    Making Property Inspections Simple & Reliable
                </h2>

                <p class="text-secondary">
                    PropCheck connects property owners with certified engineers
                    for professional building inspections and detailed reports.
                </p>

                <p class="text-secondary">
                    Clients can easily book inspections, communicate with engineers,
                    track requests, and receive inspection reports online.
                </p>

                <div class="row mt-4">
                    <div class="col-4 text-center">
                        <h3 class="fw-bold text-warning">500+</h3>
                        <small>Inspections</small>
                    </div>

                    <div class="col-4 text-center">
                        <h3 class="fw-bold text-warning">100+</h3>
                        <small>Engineers</small>
                    </div>

                    <div class="col-4 text-center">
                        <h3 class="fw-bold text-warning">98%</h3>
                        <small>Satisfaction</small>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>