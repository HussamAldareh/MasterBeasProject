@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<div class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">
            <!-- Left — Text -->
            <div class="col-md-6">
                <h1 class="display-4 fw-bold mb-3" style="line-height:1.2;">
                    Buy Your Property<br>
                    <span style="color:#EF9F27;">With Confidence</span>
                </h1>
                <p class="mb-4" style="color:#aaa;font-size:17px;line-height:1.7;">
                    Connect with certified engineers for a professional inspection report before you sign anything.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a asp-controller="Engineer" asp-action="Index" class="btn btn-primary btn-lg px-4">
                        <i class="bi bi-search me-2"></i>Find an Engineer
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-outline-secondary btn-lg px-4">
                        Get Started
                    </a>
                </div>
                <div class="d-flex gap-4 mt-4">
                    <div>
                        <h4 class="fw-bold mb-0" style="color:#EF9F27;">100+</h4>
                        <small style="color:#666;">Certified Engineers</small>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0" style="color:#EF9F27;">500+</h4>
                        <small style="color:#666;">Reports Issued</small>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0" style="color:#EF9F27;">4.9★</h4>
                        <small style="color:#666;">Average Rating</small>
                    </div>
                </div>
            </div>
            <!-- Right — Image -->
            <div class="col-md-6 text-center">
                <img src="~/images/Hero2.png" alt="Property Inspection"
                     class="img-fluid rounded-3 shadow"
                     style="max-height:420px;object-fit:cover;border:1px solid #222;" />
            </div>
        </div>
    </div>
</div>

<!-- How It Works -->
<div style="background:#111;" class="py-5">
    <div class="container">
        <h2 class="text-center fw-bold mb-5">How It Works</h2>
        <div class="row g-4 text-center">
            <div class="col-md-3">
                <div class="p-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:70px;height:70px;background:rgba(239,159,39,.1);border:1px solid rgba(239,159,39,.3);">
                        <i class="bi bi-map fs-2 text-warning"></i>
                    </div>
                    <h5 class="fw-bold">1. Enter Property</h5>
                    <p class="text-muted">Add the property address and details you want inspected.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:70px;height:70px;background:rgba(239,159,39,.1);border:1px solid rgba(239,159,39,.3);">
                        <i class="bi bi-person-check fs-2 text-warning"></i>
                    </div>
                    <h5 class="fw-bold">2. Choose Engineer</h5>
                    <p class="text-muted">Browse certified engineers with real ratings and fair prices.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:70px;height:70px;background:rgba(239,159,39,.1);border:1px solid rgba(239,159,39,.3);">
                        <i class="bi bi-house-check fs-2 text-warning"></i>
                    </div>
                    <h5 class="fw-bold">3. Get Inspected</h5>
                    <p class="text-muted">The engineer visits the property and documents everything.</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="p-4">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:70px;height:70px;background:rgba(239,159,39,.1);border:1px solid rgba(239,159,39,.3);">
                        <i class="bi bi-file-earmark-check fs-2 text-warning"></i>
                    </div>
                    <h5 class="fw-bold">4. Receive Report</h5>
                    <p class="text-muted">Get a certified PDF report within 48 hours.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Why PropCheck -->
<div style="background:#0a0a0a;border-top:1px solid #222;border-bottom:1px solid #222;" class="py-5">
    <div class="container">
        <h2 class="text-center fw-bold mb-5">Why PropCheck?</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 p-3" style="border:1px solid rgba(239,159,39,.2) !important;">
                    <div class="card-body">
                        <i class="bi bi-shield-check fs-2 text-warning mb-3 d-block"></i>
                        <h5 class="fw-bold">Certified Engineers</h5>
                        <p class="text-muted">All engineers are verified professionals with proven track records.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 p-3" style="border:1px solid rgba(239,159,39,.2) !important;">
                    <div class="card-body">
                        <i class="bi bi-file-pdf fs-2 text-warning mb-3 d-block"></i>
                        <h5 class="fw-bold">Documented Report</h5>
                        <p class="text-muted">Receive a detailed PDF report with photos covering every aspect of the property.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 p-3" style="border:1px solid rgba(239,159,39,.2) !important;">
                    <div class="card-body">
                        <i class="bi bi-chat-dots fs-2 text-warning mb-3 d-block"></i>
                        <h5 class="fw-bold">Direct Communication</h5>
                        <p class="text-muted">Chat directly with your engineer before and after the inspection.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- CTA -->
<div style="background:#111;" class="py-5">
    <div class="container text-center">
        <h2 class="fw-bold mb-3">Ready to inspect your property?</h2>
        <p class="text-muted mb-4">Join hundreds of smart buyers who made informed decisions with PropCheck.</p>
        <a asp-controller="Engineer" asp-action="Index" class="btn btn-primary btn-lg px-5">
            Find an Engineer Now
        </a>
    </div>
</div>
