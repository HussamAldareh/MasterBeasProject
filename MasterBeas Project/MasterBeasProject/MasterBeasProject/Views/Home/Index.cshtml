@{
    ViewData["Title"] = "Home";
}

<style>
    /* Button styles for Hero Section */
    .btn-primary-custom {
        background-color: #EF9F27;
        color: #111;
        border: none;
        font-weight: 600;
        transition: background-color 0.2s ease;
    }

        .btn-primary-custom:hover {
            background-color: #d88c21;
            color: #111;
        }

    .btn-outline-custom {
        color: #fff;
        border: 1px solid #555;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .btn-outline-custom:hover {
            background-color: rgba(255, 255, 255, 0.1);
            border-color: #888;
            color: #fff;
        }
</style>

<div class="hero-section py-5" style="background-color: #0a0a0a;">
    <div class="container">
        <div class="row align-items-center g-5">
            <div class="col-md-6">
                <h1 class="display-4 fw-bold mb-3" style="line-height:1.2; color:#fff;">
                    Buy Your Property<br>
                    <span style="color:#EF9F27;">With Confidence</span>
                </h1>
                <p class="mb-4" style="color:#aaa;font-size:17px;line-height:1.7;">
                    Connect with certified engineers for a professional inspection report before you sign anything.
                </p>
                <div class="d-flex flex-column gap-3">

                    <form asp-controller="Home"
                          asp-action="SearchEngineers"
                          method="get"
                          class="row g-2">

                        <div class="col-md-5">
                            <input type="text"
                                   name="engineerName"
                                   class="form-control form-control-lg"
                                   placeholder="Engineer Name" />
                        </div>

                        <div class="col-md-4">
                            <input type="text"
                                   name="city"
                                   class="form-control form-control-lg"
                                   placeholder="City" />
                        </div>

                        <div class="col-md-3">
                            <button type="submit"
                                    class="btn btn-primary-custom btn-lg w-100">
                                <i class="bi bi-search me-2"></i>Search
                            </button>
                        </div>

                    </form>

                    @if (User.Identity != null && !User.Identity.IsAuthenticated)
                    {
                        <a asp-area="Identity"
                           asp-page="/Account/Register"
                           class="btn btn-outline-custom btn-lg px-4 align-self-start">
                            Get Started
                        </a>
                    }
                    else
                    {
                        <a asp-area="Identity"
                           hidden
                           asp-page="/Account/Register"
                           class="btn btn-outline-custom btn-lg px-4">
                            Get Started
                        </a>
                    }

                </div>

                <div class="d-flex gap-4 mt-5 flex-wrap">
                    <div>
                        <h4 class="fw-bold mb-0" style="color:#EF9F27;">100+</h4>
                        <small style="color:#666;">Certified Engineers</small>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0" style="color:#EF9F27;">500+</h4>
                        <small style="color:#666;">Reports Issued</small>
                    </div>
                    <div>
                        <h4 class="fw-bold mb-0" style="color:#EF9F27;">4.9★</h4>
                        <small style="color:#666;">Average Rating</small>
                    </div>
                </div>
            </div>
            <div class="col-md-6 text-center">
                <img src="~/images/Hero2.png" alt="Property Inspection"
                     class="img-fluid rounded-3 shadow"
                     style="max-height:420px;object-fit:cover;border:1px solid #222;" />
            </div>
        </div>
    </div>
</div>

<div id="how-it-works" class="py-5" style="background-color: #111;">
    <div class="container">

        <h2 class="text-center fw-bold mb-5 text-white">How It Works</h2>

        <div class="row mb-5 justify-content-center">
            <div class="col-lg-10">
                <div class="video-banner-container shadow-lg" style="position: relative; width: 100%; height: 430px; overflow: hidden; border-radius: 15px; border: 2px solid #222;">
                    <video autoplay muted loop playsinline
                           style="position: absolute; top: 50%; left: 50%; width: 100%; height: 100%; transform: translate(-50%, -50%); object-fit: cover; z-index: 0;">
                        <source src="~/images/Video.mp4" type="video/mp4">
                    </video>
                    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.2); z-index: 1;"></div>
                </div>
            </div>
        </div>

        <div class="row g-4 text-center">

            <div class="col-md-3">
                <div class="p-4 rounded-3 h-100" style="background: #1a1a1a; border: 1px solid #222; transition: transform 0.2s ease, border-color 0.2s ease;" onmouseover="this.style.transform='translateY(-5px)'; this.style.borderColor='#EF9F27'" onmouseout="this.style.transform='translateY(0)'; this.style.borderColor='#222'">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:70px;height:70px;background:rgba(239,159,39,.1);border:1px solid rgba(239,159,39,.3);">
                        <i class="bi bi-map fs-2 text-warning"></i>
                    </div>
                    <h5 class="fw-bold text-white">1. Enter Property</h5>
                    <p class="text-muted" style="color: #aaa !important;">Add the property address and details you want inspected.</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="p-4 rounded-3 h-100" style="background: #1a1a1a; border: 1px solid #222; transition: transform 0.2s ease, border-color 0.2s ease;" onmouseover="this.style.transform='translateY(-5px)'; this.style.borderColor='#EF9F27'" onmouseout="this.style.transform='translateY(0)'; this.style.borderColor='#222'">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:70px;height:70px;background:rgba(239,159,39,.1);border:1px solid rgba(239,159,39,.3);">
                        <i class="bi bi-person-check fs-2 text-warning"></i>
                    </div>
                    <h5 class="fw-bold text-white">2. Choose Engineer</h5>
                    <p class="text-muted" style="color: #aaa !important;">Browse certified engineers with real ratings and fair prices.</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="p-4 rounded-3 h-100" style="background: #1a1a1a; border: 1px solid #222; transition: transform 0.2s ease, border-color 0.2s ease;" onmouseover="this.style.transform='translateY(-5px)'; this.style.borderColor='#EF9F27'" onmouseout="this.style.transform='translateY(0)'; this.style.borderColor='#222'">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:70px;height:70px;background:rgba(239,159,39,.1);border:1px solid rgba(239,159,39,.3);">
                        <i class="bi bi-house-check fs-2 text-warning"></i>
                    </div>
                    <h5 class="fw-bold text-white">3. Get Inspected</h5>
                    <p class="text-muted" style="color: #aaa !important;">The engineer visits the property and documents everything.</p>
                </div>
            </div>

            <div class="col-md-3">
                <div class="p-4 rounded-3 h-100" style="background: #1a1a1a; border: 1px solid #222; transition: transform 0.2s ease, border-color 0.2s ease;" onmouseover="this.style.transform='translateY(-5px)'; this.style.borderColor='#EF9F27'" onmouseout="this.style.transform='translateY(0)'; this.style.borderColor='#222'">
                    <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width:70px;height:70px;background:rgba(239,159,39,.1);border:1px solid rgba(239,159,39,.3);">
                        <i class="bi bi-file-earmark-check fs-2 text-warning"></i>
                    </div>
                    <h5 class="fw-bold text-white">4. Receive Report</h5>
                    <p class="text-muted" style="color: #aaa !important;">Get a certified PDF report within 48 hours.</p>
                </div>
            </div>

        </div>
    </div>
</div>

<div style="background:#0a0a0a;border-top:1px solid #222;border-bottom:1px solid #222;" class="py-5">
    <div class="container">
        <h2 class="text-center fw-bold mb-5 text-white">Why PropCheck?</h2>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 p-3" style="background: transparent; border:1px solid rgba(239,159,39,.2) !important;">
                    <div class="card-body">
                        <i class="bi bi-shield-check fs-2 text-warning mb-3 d-block"></i>
                        <h5 class="fw-bold text-white">Certified Engineers</h5>
                        <p class="text-muted" style="color: #aaa !important;">All engineers are verified professionals with proven track records.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 p-3" style="background: transparent; border:1px solid rgba(239,159,39,.2) !important;">
                    <div class="card-body">
                        <i class="bi bi-file-pdf fs-2 text-warning mb-3 d-block"></i>
                        <h5 class="fw-bold text-white">Documented Report</h5>
                        <p class="text-muted" style="color: #aaa !important;">Receive a detailed PDF report with photos covering every aspect of the property.</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card h-100 p-3" style="background: transparent; border:1px solid rgba(239,159,39,.2) !important;">
                    <div class="card-body">
                        <i class="bi bi-chat-dots fs-2 text-warning mb-3 d-block"></i>
                        <h5 class="fw-bold text-white">Direct Communication</h5>
                        <p class="text-muted" style="color: #aaa !important;">Chat directly with your engineer before and after the inspection.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<div style="background:#111;" class="py-5">
    <div class="container">

        <h2 class="text-center fw-bold mb-4 text-white">
            Top Rated Engineers
        </h2>

        <div class="row g-3 mb-5">

            @foreach (var engineer in (List<MasterBeasProject.Models.EngineerProfile>)ViewBag.TopEngineers)
            {
                <div class="col-lg-3 col-md-6">

                    <div class="card h-100 text-center"
                         style="background:#1a1a1a;border:1px solid #222;">

                        <div class="card-body p-3">

                            <img src="@(engineer.User.ProfileImageUrl ?? "/images/default-user.png")"
                                 class="rounded-circle mb-2"
                                 width="70"
                                 height="70"
                                 style="object-fit:cover;" />

                            <h6 class="text-white fw-bold mb-1">
                                @engineer.User.FullName
                            </h6>

                            <p class="text-warning mb-1">
                                @engineer.Specialization
                            </p>

                            <p class="text-muted small mb-1">
                                @(engineer.City ?? "Jordan")
                            </p>

                            <p class="text-warning mb-2">
                                ⭐ @engineer.AverageRating
                            </p>

                            <a asp-controller="Engineer"
                               asp-action="Details"
                               asp-route-id="@engineer.Id"
                               class="btn btn-sm btn-primary-custom">
                                View Profile
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>

        <div class="text-center">
            <h2 class="fw-bold mb-3 text-white">
                Ready to inspect your property?
            </h2>

            <p class="text-muted mb-4" style="color:#aaa !important;">
                Join hundreds of smart buyers who made informed decisions with PropCheck.
            </p>

            <a asp-controller="Engineer"
               asp-action="Index"
               class="btn btn-lg px-5 btn-primary-custom">
                Find an Engineer Now
            </a>
        </div>

    </div>
</div>