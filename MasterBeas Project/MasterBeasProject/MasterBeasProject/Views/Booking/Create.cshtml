@model MasterBeasProject.Models.PropertyDetails
@{
    ViewData["Title"] = "Book Inspection";
    var engineer = ViewBag.Engineer as MasterBeasProject.Models.EngineerProfile;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            <!-- Engineer Info Card -->
            <div class="p-4 mb-4 d-flex align-items-center gap-3"
                 style="background:#111;border:1px solid rgba(239,159,39,.2);border-radius:14px;">
                @if (!string.IsNullOrEmpty(engineer?.User?.ProfileImageUrl))
                {
                    <img src="@engineer.User.ProfileImageUrl" class="rounded-circle"
                         style="width:65px;height:65px;object-fit:cover;border:2px solid #EF9F27;" />
                }
                else
                {
                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                         style="width:65px;height:65px;background:#EF9F27;color:#0a0a0a;font-size:24px;">
                        @engineer?.User?.FullName?.FirstOrDefault()
                    </div>
                }
                <div class="flex-grow-1">
                    <h5 class="mb-0 fw-bold">@engineer?.User?.FullName</h5>
                    <small style="color:#888;">@engineer?.Specialization</small>
                    <div class="mt-1">
                        <i class="bi bi-star-fill" style="color:#EF9F27;font-size:12px;"></i>
                        <span style="color:#EF9F27;font-size:13px;">@engineer?.AverageRating.ToString("0.0")</span>
                    </div>
                </div>
                <div class="text-end">
                    <div style="color:#EF9F27;font-size:22px;font-weight:700;">@engineer?.InspectionPrice JD</div>
                    <small style="color:#666;">per inspection</small>
                </div>
            </div>

            <!-- Form -->
            <div style="background:#111;border:1px solid #222;border-radius:14px;overflow:hidden;">
                <div class="p-4" style="border-bottom:1px solid #222;">
                    <h5 class="mb-0 fw-bold">Inspection Request Details</h5>
                </div>
                <div class="p-4">
                    <form asp-action="Create" asp-route-engineerId="@ViewBag.EngineerId" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4"></div>

                        <!-- Map -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">Property Location</label>
                            <div id="map" class="mb-2"
                                 style="height:280px;border-radius:10px;border:1px solid #333;z-index:0;"></div>
                            <input type="text" id="addressInput" name="propertyAddress"
                                   class="form-control" placeholder="Click on map or type address..."
                                   required minlength="10" maxlength="300" />
                            <input type="hidden" name="latitude" id="latInput" />
                            <input type="hidden" name="longitude" id="lngInput" />
                            <small style="color:#555;">Click on the map to pin location automatically.</small>
                        </div>

                        <!-- Date -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">Preferred Inspection Date</label>
                            <input type="datetime-local" name="inspectionDate" class="form-control" required />
                        </div>

                        <div style="border-top:1px solid #222;padding-top:20px;margin-bottom:20px;">
                            <h6 class="fw-bold mb-3" style="color:#EF9F27;">
                                <i class="bi bi-building me-2"></i>Property Details
                            </h6>
                        </div>

                        <!-- Property Type -->
                        <div class="mb-3">
                            <label asp-for="PropertyType" class="form-label"></label>
                            <select asp-for="PropertyType" class="form-select"
                                    asp-items="Html.GetEnumSelectList<MasterBeasProject.Models.PropertyType>()">
                            </select>
                            <span asp-validation-for="PropertyType" class="text-danger small"></span>
                        </div>

                        <!-- Area, Floor, Age -->
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Area" class="form-label"></label>
                                <div class="input-group">
                                    <input asp-for="Area" type="number" class="form-control" min="20" step="0.5" />
                                    <span class="input-group-text">m²</span>
                                </div>
                                <span asp-validation-for="Area" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="FloorNumber" class="form-label"></label>
                                <input asp-for="FloorNumber" type="number" class="form-control" min="0" />
                                <span asp-validation-for="FloorNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="BuildingAge" class="form-label"></label>
                                <input asp-for="BuildingAge" type="number" class="form-control" min="1" />
                                <span asp-validation-for="BuildingAge" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Bedrooms, Bathrooms -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Bedrooms" class="form-label"></label>
                                <input asp-for="Bedrooms" type="number" class="form-control" min="1" />
                                <span asp-validation-for="Bedrooms" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Bathrooms" class="form-label"></label>
                                <input asp-for="Bathrooms" type="number" class="form-control" min="1" />
                                <span asp-validation-for="Bathrooms" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Elevator & Parking -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-check p-3" style="background:#1a1a1a;border-radius:10px;">
                                    <input asp-for="HasElevator" class="form-check-input" type="checkbox" />
                                    <label asp-for="HasElevator" class="form-check-label">Has Elevator</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check p-3" style="background:#1a1a1a;border-radius:10px;">
                                    <input asp-for="HasParking" class="form-check-input" type="checkbox" />
                                    <label asp-for="HasParking" class="form-check-label">Has Parking</label>
                                </div>
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label asp-for="AdditionalDescription" class="form-label"></label>
                            <textarea asp-for="AdditionalDescription" class="form-control" rows="3"
                                      placeholder="Any additional info about the property..."></textarea>
                            <span asp-validation-for="AdditionalDescription" class="text-danger small"></span>
                        </div>

                        <!-- Notes -->
                        <div class="mb-4">
                            <label class="form-label">Additional Notes <span style="color:#555;">(optional)</span></label>
                            <textarea name="notes" class="form-control" rows="2"
                                      placeholder="Any special requests for the engineer..."></textarea>
                        </div>

                        <!-- Price Summary -->
                        <div class="p-3 mb-4 d-flex justify-content-between align-items-center"
                             style="background:rgba(239,159,39,.05);border:1px solid rgba(239,159,39,.2);border-radius:10px;">
                            <span style="color:#aaa;">
                                <i class="bi bi-info-circle me-2" style="color:#EF9F27;"></i>Inspection fee
                            </span>
                            <span style="color:#EF9F27;font-weight:700;font-size:18px;">@engineer?.InspectionPrice JD</span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="bi bi-calendar-check me-2"></i>Submit Booking Request
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.css" />
    <script>
        var map = L.map('map').setView([31.9454, 35.9284], 11);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        var marker;

        L.Control.geocoder({ defaultMarkGeocode: false, placeholder: 'Search address...' })
            .on('markgeocode', function (e) {
                placeMarker(e.geocode.center);
                document.getElementById('addressInput').value = e.geocode.name;
                map.setView(e.geocode.center, 15);
            }).addTo(map);

        map.on('click', function (e) {
            placeMarker(e.latlng);
            fetch(`https://nominatim.openstreetmap.org/reverse?lat=${e.latlng.lat}&lon=${e.latlng.lng}&format=json`)
                .then(r => r.json())
                .then(data => { if (data.display_name) document.getElementById('addressInput').value = data.display_name; });
        });

        function placeMarker(latlng) {
            if (marker) marker.remove();
            marker = L.marker(latlng).addTo(map);
            document.getElementById('latInput').value = latlng.lat;
            document.getElementById('lngInput').value = latlng.lng;
        }
    </script>
}
