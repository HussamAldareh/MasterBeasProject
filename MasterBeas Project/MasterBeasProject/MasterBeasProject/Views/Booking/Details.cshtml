@model MasterBeasProject.Models.Booking
@{
    ViewData["Title"] = "Booking Details";
    bool isClient = ViewBag.IsClient;
    bool isEngineer = ViewBag.IsEngineer;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <!-- Booking Info -->
    <div class="col-md-5">
        <div class="card shadow-sm mb-3">
            <div class="card-header d-flex justify-content-between">
                <span>Booking #@Model.Id</span>
                @switch (Model.Status)
                {
                    case MasterBeasProject.Models.BookingStatus.Pending:
                        <span class="badge bg-warning text-dark">Pending</span>
                        break;
                    case MasterBeasProject.Models.BookingStatus.Accepted:
                        <span class="badge bg-success">Accepted</span>
                        break;
                    case MasterBeasProject.Models.BookingStatus.Completed:
                        <span class="badge bg-primary">Completed</span>
                        break;
                    default:
                        <span class="badge bg-secondary">@Model.Status</span>
                        break;
                }
            </div>
            <div class="card-body">
                <ul class="list-unstyled mb-0">
                    <li class="mb-2"><strong>Client:</strong> @Model.Client?.FullName</li>
                    <li class="mb-2"><strong>Engineer:</strong> @Model.EngineerProfile?.User?.FullName</li>
                    <li class="mb-2"><strong>Address:</strong> @Model.PropertyAddress</li>
                    <li class="mb-2"><strong>Date:</strong> @Model.InspectionDate.ToString("MMM dd, yyyy — hh:mm tt")</li>
                    <li class="mb-2"><strong>Price:</strong> @Model.Price JD</li>
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <li class="mb-2"><strong>Notes:</strong> @Model.Notes</li>
                    }
                </ul>
            </div>
        </div>

        <!-- Property Details -->
        @if (Model.PropertyDetails != null)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header">Property Details</div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li><strong>Type:</strong> @Model.PropertyDetails.PropertyType</li>
                        <li><strong>Area:</strong> @Model.PropertyDetails.Area m²</li>
                        <li><strong>Floor:</strong> @Model.PropertyDetails.FloorNumber</li>
                        @if (Model.PropertyDetails.Bedrooms.HasValue)
                        {
                            <li><strong>Bedrooms:</strong> @Model.PropertyDetails.Bedrooms</li>
                        }
                        @if (Model.PropertyDetails.Bathrooms.HasValue)
                        {
                            <li><strong>Bathrooms:</strong> @Model.PropertyDetails.Bathrooms</li>
                        }
                        @if (Model.PropertyDetails.BuildingAge.HasValue)
                        {
                            <li><strong>Building Age:</strong> @Model.PropertyDetails.BuildingAge years</li>
                        }
                        <li><strong>Elevator:</strong> @(Model.PropertyDetails.HasElevator ? "Yes" : "No")</li>
                        <li><strong>Parking:</strong> @(Model.PropertyDetails.HasParking ? "Yes" : "No")</li>
                    </ul>
                </div>
            </div>
        }

        <!-- Map -->
        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
        {
            <div class="card shadow-sm mb-3">
                <div class="card-header">Location</div>
                <div class="card-body p-0">
                    <div id="map" style="height:200px;border-radius:0 0 8px 8px;"></div>
                </div>
            </div>
        }

        <!-- Report -->
        @if (Model.InspectionReport != null)
        {
            <div class="card shadow-sm mb-3 border-success">
                <div class="card-header bg-success text-white">
                    <i class="bi bi-file-check me-2"></i>Inspection Report Ready
                </div>
                <div class="card-body">
                    <p class="mb-2">Report #@Model.InspectionReport.ReportNumber</p>
                    <p class="mb-2">Overall Score: <strong>@Model.InspectionReport.OverallScore / 100</strong></p>
                    <a asp-controller="Report" asp-action="Download" asp-route-id="@Model.InspectionReport.Id"
                       class="btn btn-success w-100">
                        <i class="bi bi-download me-2"></i>Download PDF
                    </a>
                </div>
            </div>
        }
    </div>


    @if (Model.Status == MasterBeasProject.Models.BookingStatus.Accepted && isClient)
    {
        <a asp-controller="Payment" asp-action="Checkout" asp-route-bookingId="@Model.Id"
           class="btn btn-warning w-100 mt-2">
            <i class="bi bi-credit-card me-2"></i>Pay Now — @Model.Price JD
        </a>
    }



    <!-- Chat -->
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header">
                <i class="bi bi-chat-dots me-2"></i>Chat
            </div>
            <div class="card-body p-0">
                <!-- Messages -->
                <div id="chatBox" style="height:350px;overflow-y:auto;padding:16px;">
                    @if (!Model.ChatMessages.Any())
                    {
                        <p class="text-muted text-center mt-5">No messages yet. Start the conversation!</p>
                    }
                    @foreach (var msg in Model.ChatMessages.OrderBy(m => m.SentAt))
                    {
                        <div class="mb-3 @(msg.SenderId == Model.ClientId ? "text-end" : "")">
                            <small class="text-muted d-block">@msg.Sender?.FullName — @msg.SentAt.ToString("hh:mm tt")</small>
                            <span class="badge @(msg.SenderId == Model.ClientId ? "bg-primary" : "bg-secondary") text-wrap"
                                  style="max-width:75%;white-space:normal;text-align:left;">
                                @msg.Message
                            </span>
                        </div>
                    }
                </div>

                <!-- Input -->
                @if (Model.Status != MasterBeasProject.Models.BookingStatus.Cancelled &&
                                Model.Status != MasterBeasProject.Models.BookingStatus.Rejected)
                {
                    <div class="border-top p-3 d-flex gap-2">
                        <input type="text" id="messageInput" class="form-control"
                               placeholder="Type a message..." maxlength="1000" />
                        <button id="sendBtn" class="btn btn-primary">
                            <i class="bi bi-send"></i>
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-3">
    @if (isClient)
    {
        <a asp-action="MyBookings" class="btn btn-outline-secondary">Back to My Bookings</a>
    }
    else
    {
        <a asp-controller="Engineer" asp-action="Dashboard" class="btn btn-outline-secondary">Back to Dashboard</a>
    }
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
    {
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
        <script>
            var map = L.map('map').setView([@Model.Latitude, @Model.Longitude], 15);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(map);
            L.marker([@Model.Latitude, @Model.Longitude]).addTo(map);
        </script>
    }

    <script>
        const bookingId = @Model.Id;
        const chatBox = document.getElementById("chatBox");
        const currentUserId = "@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value";

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/chatHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ReceiveMessage", function (data) {
            appendMessage(data.senderName, data.message, data.sentAt, data.senderId === currentUserId);
            chatBox.scrollTop = chatBox.scrollHeight;
        });

        connection.start().then(function () {
            connection.invoke("JoinBookingChat", bookingId);
        });

        document.getElementById("sendBtn")?.addEventListener("click", sendMessage);
        document.getElementById("messageInput")?.addEventListener("keypress", function (e) {
            if (e.key === "Enter") sendMessage();
        });

        function sendMessage() {
            const input = document.getElementById("messageInput");
            const msg = input.value.trim();
            if (!msg) return;
            connection.invoke("SendMessage", bookingId, msg);
            input.value = "";
        }

        function appendMessage(sender, message, time, isMine) {
            const div = document.createElement("div");
            div.className = "mb-3" + (isMine ? " text-end" : "");
            div.innerHTML = `<small class="text-muted d-block">${sender} — ${time}</small>
                <span class="badge ${isMine ? 'bg-primary' : 'bg-secondary'} text-wrap"
                      style="max-width:75%;white-space:normal;text-align:left;">${message}</span>`;
            chatBox.appendChild(div);
        }

        chatBox.scrollTop = chatBox.scrollHeight;
    </script>
}