@model IEnumerable<MasterBeasProject.Models.Booking>
@{
    ViewData["Title"] = "My Bookings";
}

<h2 class="mb-4">My Bookings</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-light text-center py-5">
        <i class="bi bi-calendar-x fs-1 text-muted"></i>
        <p class="mt-3 text-muted">No bookings yet.</p>
        <a asp-controller="Engineer" asp-action="Index" class="btn btn-primary">Find an Engineer</a>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var booking in Model)
        {
            <div class="col">
                <div class="card shadow-sm h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>
                            <i class="bi bi-person-badge me-2"></i>
                            @booking.EngineerProfile?.User?.FullName
                        </span>
                        @switch (booking.Status)
                        {
                            case MasterBeasProject.Models.BookingStatus.Pending:
                                <span class="badge bg-warning text-dark">Pending</span>
                                break;
                            case MasterBeasProject.Models.BookingStatus.Accepted:
                                <span class="badge bg-success">Accepted</span>
                                break;
                            case MasterBeasProject.Models.BookingStatus.Rejected:
                                <span class="badge bg-danger">Rejected</span>
                                break;
                            case MasterBeasProject.Models.BookingStatus.Completed:
                                <span class="badge bg-primary">Completed</span>
                                break;
                            case MasterBeasProject.Models.BookingStatus.Cancelled:
                                <span class="badge bg-secondary">Cancelled</span>
                                break;
                            default:
                                <span class="badge bg-secondary">@booking.Status</span>
                                break;
                        }
                    </div>
                    <div class="card-body">
                        <p class="mb-1"><i class="bi bi-geo-alt me-2 text-muted"></i>@booking.PropertyAddress</p>
                        <p class="mb-1"><i class="bi bi-calendar me-2 text-muted"></i>@booking.InspectionDate.ToString("MMM dd, yyyy — hh:mm tt")</p>
                        <p class="mb-1"><i class="bi bi-house me-2 text-muted"></i>@booking.PropertyDetails?.PropertyType — @booking.PropertyDetails?.Area m²</p>
                        <p class="mb-0"><i class="bi bi-cash me-2 text-muted"></i>@booking.Price JD</p>

                        @if (booking.Status == MasterBeasProject.Models.BookingStatus.Rejected && !string.IsNullOrEmpty(booking.RejectionReason))
                        {
                            <div class="alert alert-danger mt-2 mb-0 py-2 small">
                                <strong>Rejection reason:</strong> @booking.RejectionReason
                            </div>
                        }
                    </div>
                    <div class="card-footer bg-white d-flex gap-2">
                        <a asp-action="Details" asp-route-id="@booking.Id"
                           class="btn btn-outline-primary btn-sm flex-grow-1">Details & Chat</a>

                        @if (booking.InspectionReport != null)
                        {
                            <a asp-controller="Report" asp-action="Download" asp-route-id="@booking.InspectionReport.Id"
                               class="btn btn-success btn-sm">
                                <i class="bi bi-file-pdf"></i> Report
                            </a>
                        }

                        @if (booking.Status == MasterBeasProject.Models.BookingStatus.Pending)
                        {
                            <form asp-action="Cancel" asp-route-id="@booking.Id" method="post"
                                  onsubmit="return confirm('Cancel this booking?')">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-outline-danger btn-sm">Cancel</button>
                            </form>
                        }

                        @if (booking.Status == MasterBeasProject.Models.BookingStatus.Completed && booking.Review == null)
                        {
                            <a asp-controller="Review" asp-action="Create" asp-route-bookingId="@booking.Id"
                               class="btn btn-warning btn-sm">Rate</a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}
