@model IEnumerable<MasterBeasProject.Models.Booking>
@{
    ViewData["Title"] = "My Bookings";
}

<!-- Header -->
<div style="background:linear-gradient(180deg,#111 0%,#0a0a0a 100%);border-bottom:1px solid #222;padding:40px 0 25px;">
    <div class="container">
        <h1 class="fw-bold mb-1" style="font-size:30px;">My <span style="color:#EF9F27;">Bookings</span></h1>
        <p style="color:#666;margin:0;">Track your inspection requests and reports.</p>
    </div>
</div>

<div class="container py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="text-center py-5" style="background:#111;border:1px solid #222;border-radius:14px;">
            <i class="bi bi-calendar-x" style="font-size:48px;color:#333;"></i>
            <p class="mt-3 mb-4" style="color:#666;">No bookings yet. Find an engineer and get started.</p>
            <a asp-controller="Engineer" asp-action="Index" class="btn btn-primary px-4">
                <i class="bi bi-search me-2"></i>Find an Engineer
            </a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @foreach (var booking in Model)
            {
                <div class="col">
                    <div class="h-100 d-flex flex-column"
                         style="background:#111;border:1px solid #222;border-radius:14px;overflow:hidden;">

                        <!-- Card Header -->
                        <div class="p-3 d-flex justify-content-between align-items-center"
                             style="border-bottom:1px solid #1a1a1a;">
                            <div class="d-flex align-items-center gap-2">
                                <i class="bi bi-person-badge" style="color:#EF9F27;"></i>
                                <span style="color:white;font-weight:500;font-size:14px;">
                                    @booking.EngineerProfile?.User?.FullName
                                </span>
                            </div>
                            @switch (booking.Status)
                            {
                                case MasterBeasProject.Models.BookingStatus.Pending:
                                    <span style="background:rgba(239,159,39,.15);color:#EF9F27;border:1px solid rgba(239,159,39,.3);padding:3px 10px;border-radius:20px;font-size:12px;">Pending</span>
                                    break;
                                case MasterBeasProject.Models.BookingStatus.Accepted:
                                    <span style="background:rgba(26,107,58,.2);color:#5DCAA5;border:1px solid rgba(26,107,58,.3);padding:3px 10px;border-radius:20px;font-size:12px;">Accepted</span>
                                    break;
                                case MasterBeasProject.Models.BookingStatus.InProgress:
                                    <span style="background:rgba(24,95,165,.2);color:#7BB8F0;border:1px solid rgba(24,95,165,.3);padding:3px 10px;border-radius:20px;font-size:12px;">In Progress</span>
                                    break;
                                case MasterBeasProject.Models.BookingStatus.Rejected:
                                    <span style="background:rgba(139,26,26,.2);color:#F09595;border:1px solid rgba(139,26,26,.3);padding:3px 10px;border-radius:20px;font-size:12px;">Rejected</span>
                                    break;
                                case MasterBeasProject.Models.BookingStatus.Completed:
                                    <span style="background:rgba(24,95,165,.2);color:#7BB8F0;border:1px solid rgba(24,95,165,.3);padding:3px 10px;border-radius:20px;font-size:12px;">Completed</span>
                                    break;
                                case MasterBeasProject.Models.BookingStatus.Cancelled:
                                    <span style="background:#1a1a1a;color:#666;border:1px solid #333;padding:3px 10px;border-radius:20px;font-size:12px;">Cancelled</span>
                                    break;
                                default:
                                    <span style="background:#1a1a1a;color:#666;border:1px solid #333;padding:3px 10px;border-radius:20px;font-size:12px;">@booking.Status</span>
                                    break;
                            }
                        </div>

                        <!-- Card Body -->
                        <div class="p-4 flex-grow-1">
                            <div class="d-flex flex-column gap-2">
                                <div class="d-flex align-items-start gap-2" style="font-size:13px;">
                                    <i class="bi bi-geo-alt mt-1" style="color:#EF9F27;flex-shrink:0;"></i>
                                    <span style="color:#aaa;">@booking.PropertyAddress</span>
                                </div>
                                <div class="d-flex align-items-center gap-2" style="font-size:13px;">
                                    <i class="bi bi-calendar" style="color:#EF9F27;"></i>
                                    <span style="color:#aaa;">@booking.InspectionDate.ToString("MMM dd, yyyy — hh:mm tt")</span>
                                </div>
                                <div class="d-flex align-items-center gap-2" style="font-size:13px;">
                                    <i class="bi bi-house" style="color:#EF9F27;"></i>
                                    <span style="color:#aaa;">@booking.PropertyDetails?.PropertyType — @booking.PropertyDetails?.Area m²</span>
                                </div>
                                <div class="d-flex align-items-center gap-2" style="font-size:13px;">
                                    <i class="bi bi-cash" style="color:#EF9F27;"></i>
                                    <span style="color:#EF9F27;font-weight:600;">@booking.Price JD</span>
                                </div>
                            </div>

                            @if (booking.Status == MasterBeasProject.Models.BookingStatus.Rejected && !string.IsNullOrEmpty(booking.RejectionReason))
                            {
                                <div class="mt-3 p-2 small" style="background:rgba(139,26,26,.15);border:1px solid rgba(139,26,26,.3);border-radius:8px;color:#F09595;">
                                    <i class="bi bi-x-circle me-1"></i><strong>Rejection reason:</strong> @booking.RejectionReason
                                </div>
                            }
                        </div>

                        <!-- Card Footer -->
                        <div class="p-3 d-flex gap-2 flex-wrap" style="border-top:1px solid #1a1a1a;">
                            <a asp-action="Details" asp-route-id="@booking.Id"
                               class="btn btn-outline-secondary btn-sm flex-grow-1">
                                <i class="bi bi-chat-dots me-1"></i>Details & Chat
                            </a>

                            @if (booking.Status == MasterBeasProject.Models.BookingStatus.Accepted)
                            {
                                <a asp-controller="Payment" asp-action="Checkout" asp-route-bookingId="@booking.Id"
                                   class="btn btn-primary btn-sm">
                                    <i class="bi bi-credit-card me-1"></i>Pay
                                </a>
                            }

                            @if (booking.InspectionReport != null)
                            {
                                <a asp-controller="Report" asp-action="Download" asp-route-id="@booking.InspectionReport.Id"
                                   class="btn btn-sm" style="background:rgba(26,107,58,.2);color:#5DCAA5;border:1px solid rgba(26,107,58,.3);">
                                    <i class="bi bi-file-pdf me-1"></i>Report
                                </a>
                            }

                            @if (booking.Status == MasterBeasProject.Models.BookingStatus.Pending)
                            {
                                <form asp-action="Cancel" asp-route-id="@booking.Id" method="post"
                                      onsubmit="return confirm('Cancel this booking?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm"
                                            style="background:rgba(139,26,26,.2);color:#F09595;border:1px solid rgba(139,26,26,.3);">
                                        Cancel
                                    </button>
                                </form>
                            }

                            @if (booking.Status == MasterBeasProject.Models.BookingStatus.Completed && booking.Review == null)
                            {
                                <a asp-controller="Review" asp-action="Create" asp-route-bookingId="@booking.Id"
                                   class="btn btn-sm" style="background:rgba(239,159,39,.15);color:#EF9F27;border:1px solid rgba(239,159,39,.3);">
                                    <i class="bi bi-star me-1"></i>Rate
                                </a>
                            }
                        </div>

                    </div>
                </div>
            }
        </div>
    }
</div>
