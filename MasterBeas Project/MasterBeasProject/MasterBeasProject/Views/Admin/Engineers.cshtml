@model IEnumerable<MasterBeasProject.Models.EngineerProfile>
@{
    ViewData["Title"] = "All Engineers";
}

<h2 class="mb-4">All Engineers</h2>

<div class="table-responsive">
    <table class="table table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Specialization</th>
                <th>Experience</th>
                <th>Price</th>
                <th>Rating</th>
                <th>Reviews</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var engineer in Model)
            {
                <tr>
                    <td>@engineer.User?.FullName</td>
                    <td>@engineer.User?.Email</td>
                    <td>@engineer.Specialization</td>
                    <td>@engineer.YearsOfExperience yrs</td>
                    <td>@engineer.InspectionPrice JD</td>
                    <td>
                        <span class="text-warning">★</span> @engineer.AverageRating.ToString("0.0")
                    </td>
                    <td>@engineer.TotalReviews</td>
                    <td>
                        @if (engineer.IsAvailable)
                        {
                            <span class="badge bg-success">Available</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Unavailable</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<a asp-action="Dashboard" class="btn btn-outline-secondary mt-3">Back to Dashboard</a>
