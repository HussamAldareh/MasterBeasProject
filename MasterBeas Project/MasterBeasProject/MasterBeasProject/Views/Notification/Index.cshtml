@model IEnumerable<MasterBeasProject.Models.Notification>
@{
    ViewData["Title"] = "Notifications";
}

<h2 class="mb-4">Notifications</h2>

@if (!Model.Any())
{
    <div class="alert alert-light text-center py-5">
        <i class="bi bi-bell-slash fs-1 text-muted"></i>
        <p class="mt-3 text-muted">No notifications yet.</p>
    </div>
}
else
{
    <div class="list-group">
        @foreach (var n in Model)
        {
            <a href="@(n.Link ?? "#")"
               class="list-group-item list-group-item-action @(!n.IsRead ? "list-group-item-light fw-bold" : "")">
                <div class="d-flex justify-content-between">
                    <span>
                        @switch (n.Type)
                        {
                            case MasterBeasProject.Models.NotificationType.BookingAccepted:
                                <i class="bi bi-check-circle-fill text-success me-2"></i>
                                break;
                            case MasterBeasProject.Models.NotificationType.BookingRejected:
                                <i class="bi bi-x-circle-fill text-danger me-2"></i>
                                break;
                            case MasterBeasProject.Models.NotificationType.ReportReady:
                                <i class="bi bi-file-earmark-check-fill text-primary me-2"></i>
                                break;
                            case MasterBeasProject.Models.NotificationType.NewMessage:
                                <i class="bi bi-chat-fill text-info me-2"></i>
                                break;
                            default:
                                <i class="bi bi-bell-fill text-warning me-2"></i>
                                break;
                        }
                        @n.Title
                    </span>
                    <small class="text-muted">@n.CreatedAt.ToString("MMM dd, hh:mm tt")</small>
                </div>
                <small class="text-muted">@n.Body</small>
            </a>
        }
    </div>
}
