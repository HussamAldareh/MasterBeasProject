@model IEnumerable<MasterBeasProject.Models.Booking>
@{
    ViewData["Title"] = "Engineer Dashboard";
    var profile = ViewBag.Profile as MasterBeasProject.Models.EngineerProfile;
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Stats -->
<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h3 class="text-warning">@ViewBag.PendingCount</h3>
                <p class="mb-0 text-muted">Pending</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h3 class="text-success">@ViewBag.CompletedCount</h3>
                <p class="mb-0 text-muted">Completed</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <h3 class="text-primary">@profile?.AverageRating.ToString("0.0")</h3>
                <p class="mb-0 text-muted">Rating</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center shadow-sm">
            <div class="card-body">
                <form asp-action="ToggleAvailability" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="btn @(profile?.IsAvailable == true ? "btn-success" : "btn-outline-secondary") btn-sm w-100">
                        @(profile?.IsAvailable == true ? "Available ✓" : "Unavailable")
                    </button>
                </form>
                <small class="text-muted">Toggle availability</small>
            </div>
        </div>
    </div>
</div>

<!-- Bookings Table -->
<h5 class="mb-3">My Bookings</h5>
@if (!Model.Any())
{
    <div class="alert alert-light">No bookings yet.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Client</th>
                    <th>Property</th>
                    <th>Type</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in Model)
                {
                    <tr>
                        <td>@booking.Client?.FullName</td>
                        <td>@(booking.PropertyAddress.Length > 30 ? booking.PropertyAddress.Substring(0, 30) + "..." : booking.PropertyAddress)</td>
                        <td>@booking.PropertyDetails?.PropertyType</td>
                        <td>@booking.InspectionDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            @switch (booking.Status)
                            {
                                case MasterBeasProject.Models.BookingStatus.Pending:
                                    <span class="badge bg-warning text-dark">Pending</span>
                                    break;
                                case MasterBeasProject.Models.BookingStatus.Accepted:
                                    <span class="badge bg-success">Accepted</span>
                                    break;
                                case MasterBeasProject.Models.BookingStatus.Rejected:
                                    <span class="badge bg-danger">Rejected</span>
                                    break;
                                case MasterBeasProject.Models.BookingStatus.Completed:
                                    <span class="badge bg-primary">Completed</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@booking.Status</span>
                                    break;
                            }
                        </td>
                        <td>
                            <a asp-controller="Booking" asp-action="Details" asp-route-id="@booking.Id"
                               class="btn btn-sm btn-outline-primary">Details</a>

                            @if (booking.Status == MasterBeasProject.Models.BookingStatus.Pending)
                            {
                                <form asp-action="UpdateBookingStatus" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="bookingId" value="@booking.Id" />
                                    <input type="hidden" name="action" value="accept" />
                                    <button type="submit" class="btn btn-sm btn-success">Accept</button>
                                </form>

                                <button type="button" class="btn btn-sm btn-danger"
                                        data-bs-toggle="modal"
                                        data-bs-target="#rejectModal"
                                        data-booking-id="@booking.Id">
                                    Reject
                                </button>
                            }

                            @if (booking.Status == MasterBeasProject.Models.BookingStatus.Accepted)
                            {
                                <a asp-controller="Report" asp-action="Create" asp-route-bookingId="@booking.Id"
                                   class="btn btn-sm btn-warning">Create Report</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="UpdateBookingStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="action" value="reject" />
                <input type="hidden" name="bookingId" id="rejectBookingId" />
                <div class="modal-header">
                    <h5 class="modal-title">Reject Booking</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Reason for rejection</label>
                    <textarea name="rejectionReason" class="form-control" rows="3"
                              placeholder="Please provide a reason..." required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const rejectModal = document.getElementById('rejectModal');
        rejectModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            document.getElementById('rejectBookingId').value = button.getAttribute('data-booking-id');
        });
    </script>
}
