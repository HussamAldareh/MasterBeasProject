@model IEnumerable<MasterBeasProject.Models.Booking>
@{
    ViewData["Title"] = "Engineer Dashboard";
    var profile = ViewBag.Profile as MasterBeasProject.Models.EngineerProfile;
}

<!-- Header -->
<div style="background:linear-gradient(180deg,#111 0%,#0a0a0a 100%);border-bottom:1px solid #222;padding:35px 0 25px;">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                @if (!string.IsNullOrEmpty(profile?.User?.ProfileImageUrl))
                {
                    <img src="@profile.User.ProfileImageUrl" class="rounded-circle"
                         style="width:56px;height:56px;object-fit:cover;border:2px solid #EF9F27;" />
                }
                else
                {
                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                         style="width:56px;height:56px;background:#EF9F27;color:#0a0a0a;font-size:20px;flex-shrink:0;">
                        @profile?.User?.FullName?.FirstOrDefault()
                    </div>
                }
                <div>
                    <h2 class="fw-bold mb-0" style="font-size:22px;">
                        Welcome, <span style="color:#EF9F27;">@profile?.User?.FullName</span>
                    </h2>
                    <p style="color:#666;margin:0;font-size:13px;">@profile?.Specialization</p>

                    <a asp-action="EditProfile"
                       class="btn btn-warning">
                        Edit Profile
                    </a>

                    <a asp-action="ManageAvailability"
                       class="btn btn-info">
                        Working Hours
                    </a>    

                </div>
            </div>
            <form asp-action="ToggleAvailability" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn px-4"
                        style="background:@(profile?.IsAvailable == true ? "rgba(26,107,58,.2)" : "rgba(139,26,26,.15)");
                               color:@(profile?.IsAvailable == true ? "#5DCAA5" : "#F09595");
                               border:1px solid @(profile?.IsAvailable == true ? "rgba(26,107,58,.4)" : "rgba(139,26,26,.3)");
                               border-radius:10px;font-size:13px;">
                    <i class="bi bi-circle-fill me-2" style="font-size:8px;"></i>
                    @(profile?.IsAvailable == true ? "Available — Click to go Offline" : "Unavailable — Click to go Online")
                </button>
            </form>
        </div>
    </div>
</div>

<div class="container py-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mb-4">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-4">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="p-4 text-center" style="background:#111;border:1px solid #222;border-radius:14px;">
                <div style="font-size:32px;font-weight:700;color:#EF9F27;">@ViewBag.PendingCount</div>
                <div style="color:#666;font-size:13px;margin-top:4px;">Pending</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-4 text-center" style="background:#111;border:1px solid #222;border-radius:14px;">
                <div style="font-size:32px;font-weight:700;color:#5DCAA5;">@ViewBag.CompletedCount</div>
                <div style="color:#666;font-size:13px;margin-top:4px;">Completed</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-4 text-center" style="background:#111;border:1px solid #222;border-radius:14px;">
                <div style="font-size:32px;font-weight:700;color:#EF9F27;">
                    @profile?.AverageRating.ToString("0.0")<span style="font-size:16px;">★</span>
                </div>
                <div style="color:#666;font-size:13px;margin-top:4px;">Rating</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="p-4 text-center" style="background:#111;border:1px solid #222;border-radius:14px;">
                <div style="font-size:32px;font-weight:700;color:#7BB8F0;">@profile?.TotalReviews</div>
                <div style="color:#666;font-size:13px;margin-top:4px;">Reviews</div>
            </div>
        </div>
    </div>

    <!-- Bookings -->
    <div style="background:#111;border:1px solid #222;border-radius:14px;overflow:hidden;">
        <div class="p-4" style="border-bottom:1px solid #222;">
            <h5 class="fw-bold mb-0">My Bookings</h5>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-calendar-x" style="font-size:48px;color:#333;"></i>
                <p class="mt-3" style="color:#666;">No bookings yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr style="border-bottom:1px solid #1a1a1a;">
                            <th style="color:#EF9F27;font-size:12px;text-transform:uppercase;letter-spacing:.5px;padding:14px 16px;font-weight:500;background:#111;">Client</th>
                            <th style="color:#EF9F27;font-size:12px;text-transform:uppercase;letter-spacing:.5px;padding:14px 16px;font-weight:500;background:#111;">Property</th>
                            <th style="color:#EF9F27;font-size:12px;text-transform:uppercase;letter-spacing:.5px;padding:14px 16px;font-weight:500;background:#111;">Type</th>
                            <th style="color:#EF9F27;font-size:12px;text-transform:uppercase;letter-spacing:.5px;padding:14px 16px;font-weight:500;background:#111;">Date</th>
                            <th style="color:#EF9F27;font-size:12px;text-transform:uppercase;letter-spacing:.5px;padding:14px 16px;font-weight:500;background:#111;">Status</th>
                            <th style="color:#EF9F27;font-size:12px;text-transform:uppercase;letter-spacing:.5px;padding:14px 16px;font-weight:500;background:#111;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var booking in Model)
                        {
                            <tr style="border-bottom:1px solid #1a1a1a;">
                                <td style="padding:14px 16px;color:#ddd;font-size:13px;">@booking.Client?.FullName</td>
                                <td style="padding:14px 16px;color:#aaa;font-size:13px;">
                                    @(booking.PropertyAddress.Length > 28 ? booking.PropertyAddress.Substring(0, 28) + "..." : booking.PropertyAddress)
                                </td>
                                <td style="padding:14px 16px;color:#aaa;font-size:13px;">@booking.PropertyDetails?.PropertyType</td>
                                <td style="padding:14px 16px;color:#aaa;font-size:13px;">@booking.InspectionDate.ToString("MMM dd, yyyy")</td>
                                <td style="padding:14px 16px;">
                                    @switch (booking.Status)
                                    {
                                        case MasterBeasProject.Models.BookingStatus.Pending:
                                            <span style="background:rgba(239,159,39,.15);color:#EF9F27;border:1px solid rgba(239,159,39,.3);padding:3px 10px;border-radius:20px;font-size:11px;">Pending</span>
                                            break;
                                        case MasterBeasProject.Models.BookingStatus.Accepted:
                                            <span style="background:rgba(26,107,58,.2);color:#5DCAA5;border:1px solid rgba(26,107,58,.3);padding:3px 10px;border-radius:20px;font-size:11px;">Accepted</span>
                                            break;
                                        case MasterBeasProject.Models.BookingStatus.InProgress:
                                            <span style="background:rgba(24,95,165,.2);color:#7BB8F0;border:1px solid rgba(24,95,165,.3);padding:3px 10px;border-radius:20px;font-size:11px;">In Progress</span>
                                            break;
                                        case MasterBeasProject.Models.BookingStatus.Rejected:
                                            <span style="background:rgba(139,26,26,.2);color:#F09595;border:1px solid rgba(139,26,26,.3);padding:3px 10px;border-radius:20px;font-size:11px;">Rejected</span>
                                            break;
                                        case MasterBeasProject.Models.BookingStatus.Completed:
                                            <span style="background:rgba(24,95,165,.2);color:#7BB8F0;border:1px solid rgba(24,95,165,.3);padding:3px 10px;border-radius:20px;font-size:11px;">Completed</span>
                                            break;
                                        default:
                                            <span style="background:#1a1a1a;color:#666;border:1px solid #333;padding:3px 10px;border-radius:20px;font-size:11px;">@booking.Status</span>
                                            break;
                                    }
                                </td>
                                <td style="padding:14px 16px;">
                                    <div class="d-flex gap-2 flex-wrap">
                                     
                                        @if (booking.Status == MasterBeasProject.Models.BookingStatus.Pending)
                                        {
                                            <a asp-controller="Booking"
                                               asp-action="Details"
                                               asp-route-id="@booking.Id"
                                               class="btn btn-sm btn-outline-secondary"
                                               style="font-size:12px;">
                                                Details
                                            </a>

                                            @if (booking.FinalPrice == null)
                                            {
                                                <form asp-action="SetFinalPrice" method="post" class="w-100 mt-2">
                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="bookingId"
                                                           value="@booking.Id" />

                                                    <div class="input-group input-group-sm">
                                                        <input type="number"
                                                               step="0.01"
                                                               min="1"
                                                               name="finalPrice"
                                                               class="form-control"
                                                               placeholder="Enter final price" />

                                                        <button type="submit"
                                                                class="btn btn-warning">
                                                            Send Price
                                                        </button>
                                                    </div>
                                                </form>
                                            }
                                            else
                                            {
                                                <div class="w-100 mt-2">
                                                    <span class="badge bg-warning text-dark">
                                                        Final Price: @booking.FinalPrice JD
                                                    </span>
                                                </div>
                                            }

                                            @if (booking.IsPriceApproved)
                                            {
                                                <form asp-action="UpdateBookingStatus"
                                                      method="post"
                                                      class="d-inline">
                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="bookingId"
                                                           value="@booking.Id" />

                                                    <input type="hidden"
                                                           name="action"
                                                           value="accept" />

                                                    <button type="submit"
                                                            class="btn btn-sm"
                                                            style="background:rgba(26,107,58,.2);
                                           color:#5DCAA5;
                                           border:1px solid rgba(26,107,58,.3);
                                           font-size:12px;">
                                                        Accept
                                                    </button>
                                                </form>
                                            }

                                            <button type="button"
                                                    class="btn btn-sm"
                                                    style="background:rgba(139,26,26,.2);
                               color:#F09595;
                               border:1px solid rgba(139,26,26,.3);
                               font-size:12px;"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#rejectModal"
                                                    data-booking-id="@booking.Id">
                                                Reject
                                            </button>
                                        }

                                        @if (booking.Status == MasterBeasProject.Models.BookingStatus.InProgress)
                                        {
                                            <a asp-controller="Report" asp-action="Create" asp-route-bookingId="@booking.Id"
                                               class="btn btn-sm"
                                               style="background:rgba(239,159,39,.15);color:#EF9F27;border:1px solid rgba(239,159,39,.3);font-size:12px;">
                                                <i class="bi bi-file-text me-1"></i>Report
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Reject Modal -->
<div class="modal fade" id="rejectModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="UpdateBookingStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="action" value="reject" />
                <input type="hidden" name="bookingId" id="rejectBookingId" />
                <div class="modal-header">
                    <h5 class="modal-title">Reject Booking</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label">Reason for rejection</label>
                    <textarea name="rejectionReason" class="form-control" rows="3"
                              placeholder="Please provide a reason..." required></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn"
                            style="background:rgba(139,26,26,.2);color:#F09595;border:1px solid rgba(139,26,26,.3);">
                        Confirm Rejection
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const rejectModal = document.getElementById('rejectModal');
        rejectModal.addEventListener('show.bs.modal', function (event) {
            const button = event.relatedTarget;
            document.getElementById('rejectBookingId').value = button.getAttribute('data-booking-id');
        });
    </script>
}
