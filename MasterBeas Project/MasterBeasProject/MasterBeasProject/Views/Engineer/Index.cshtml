@model IEnumerable<MasterBeasProject.Models.EngineerProfile>
@{
    ViewData["Title"] = "Find Engineers";
}

<!-- Page Header -->
<div style="background:linear-gradient(180deg,#111 0%,#0a0a0a 100%);border-bottom:1px solid #222;padding:50px 0 30px;">
    <div class="container text-center">
        <h1 class="fw-bold mb-2" style="font-size:36px;">
            Find <span style="color:#EF9F27;">Certified</span> Engineers
        </h1>
        <p style="color:#888;font-size:15px;max-width:500px;margin:0 auto;">
            Connect with trusted professionals and get a detailed property inspection before purchasing.
        </p>
    </div>
</div>

<div class="container py-4">

    <!-- Filter -->
    <div class="p-4 mb-5" style="background:#111;border:1px solid rgba(239,159,39,.2);border-radius:14px;">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label" style="color:#888;font-size:13px;">Specialization</label>
                <input type="text" name="specialization" value="@ViewBag.Specialization"
                       class="form-control" placeholder="e.g. Civil Engineering" />
            </div>
            <div class="col-md-3">
                <label class="form-label" style="color:#888;font-size:13px;">Max Price (JD)</label>
                <input type="number" name="maxPrice" value="@ViewBag.MaxPrice"
                       class="form-control" placeholder="e.g. 100" min="0" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-1"></i> Filter
                </button>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">Reset</a>
            </div>
        </form>
    </div>

    <!-- Results -->
    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-person-x" style="font-size:48px;color:#333;"></i>
            <p class="mt-3" style="color:#666;">No engineers found matching your criteria.</p>
            <a asp-action="Index" class="btn btn-outline-secondary mt-2">Clear Filters</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var engineer in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="h-100 d-flex flex-column"
                         style="background:#111;border:1px solid #222;border-radius:14px;overflow:hidden;transition:all .3s;"
                         onmouseover="this.style.borderColor='rgba(239,159,39,.4)';this.style.transform='translateY(-4px)';this.style.boxShadow='0 8px 30px rgba(239,159,39,.1)'"
                         onmouseout="this.style.borderColor='#222';this.style.transform='translateY(0)';this.style.boxShadow='none'">

                        <!-- Top -->
                        <div class="p-4 flex-grow-1">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                @if (!string.IsNullOrEmpty(engineer.User?.ProfileImageUrl))
                                {
                                    <img src="@engineer.User.ProfileImageUrl"
                                         class="rounded-circle"
                                         style="width:60px;height:60px;object-fit:cover;border:2px solid #EF9F27;" />
                                }
                                else
                                {
                                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                         style="width:60px;height:60px;background:#EF9F27;color:#0a0a0a;font-size:22px;flex-shrink:0;">
                                        @engineer.User?.FullName?.FirstOrDefault()
                                    </div>
                                }
                                <div>
                                    <h5 class="mb-1 fw-bold" style="color:white;">@engineer.User?.FullName</h5>
                                    <span style="background:rgba(239,159,39,.1);color:#EF9F27;border:1px solid rgba(239,159,39,.3);padding:2px 10px;border-radius:20px;font-size:12px;">
                                        @engineer.Specialization
                                    </span>
                                </div>
                            </div>

                            <!-- Stats Row -->
                            <div class="d-flex gap-3 mb-3">
                                <div class="text-center p-2 flex-fill" style="background:#1a1a1a;border-radius:10px;">
                                    <div style="color:#EF9F27;font-weight:600;font-size:15px;">@engineer.YearsOfExperience</div>
                                    <div style="color:#666;font-size:11px;">Years Exp.</div>
                                </div>
                                <div class="text-center p-2 flex-fill" style="background:#1a1a1a;border-radius:10px;">
                                    <div style="color:#EF9F27;font-weight:600;font-size:15px;">
                                        <i class="bi bi-star-fill" style="font-size:12px;"></i> @engineer.AverageRating.ToString("0.0")
                                    </div>
                                    <div style="color:#666;font-size:11px;">@engineer.TotalReviews Reviews</div>
                                </div>
                                <div class="text-center p-2 flex-fill" style="background:#1a1a1a;border-radius:10px;">
                                    <div style="color:#EF9F27;font-weight:600;font-size:15px;">@engineer.InspectionPrice</div>
                                    <div style="color:#666;font-size:11px;">JD / Visit</div>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(engineer.Bio))
                            {
                                <p style="color:#777;font-size:13px;line-height:1.6;">
                                    @(engineer.Bio.Length > 90 ? engineer.Bio.Substring(0, 90) + "..." : engineer.Bio)
                                </p>
                            }

                            @if (engineer.IsAvailable)
                            {
                                <span style="background:rgba(26,107,58,.2);color:#5DCAA5;border:1px solid rgba(26,107,58,.3);padding:3px 10px;border-radius:20px;font-size:12px;">
                                    <i class="bi bi-circle-fill me-1" style="font-size:8px;"></i>Available
                                </span>
                            }
                            else
                            {
                                <span style="background:rgba(139,26,26,.2);color:#F09595;border:1px solid rgba(139,26,26,.3);padding:3px 10px;border-radius:20px;font-size:12px;">
                                    <i class="bi bi-circle-fill me-1" style="font-size:8px;"></i>Unavailable
                                </span>
                            }
                        </div>

                        <!-- Footer -->
                        <div class="p-3" style="border-top:1px solid #1a1a1a;">
                            <a asp-action="Details" asp-route-id="@engineer.Id"
                               class="btn btn-primary w-100">
                                View Profile & Book
                            </a>
                        </div>

                    </div>
                </div>
            }
        </div>
    }

</div>
