@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="min-vh-100 d-flex align-items-center" style="background:#0a0a0a;">
    <div class="container py-4">
        <div class="row g-0 justify-content-center" style="max-width:900px;margin:0 auto;">

            <!-- Left — Brand Side -->
            <div class="col-md-5 d-none d-md-flex flex-column justify-content-center p-5"
                 style="background:#111;border:1px solid #222;border-radius:16px 0 0 16px;">
                <div class="mb-4">
                    <h2 class="fw-bold mb-1" style="font-size:28px;">
                        <span style="color:#EF9F27;">Prop</span><span style="color:white;">Check</span>
                    </h2>
                    <p style="color:#888;font-size:14px;">Smart property inspection platform</p>
                </div>
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                             style="width:40px;height:40px;background:rgba(239,159,39,.1);border:1px solid rgba(239,159,39,.2);">
                            <i class="bi bi-shield-check" style="color:#EF9F27;"></i>
                        </div>
                        <div>
                            <p class="mb-0" style="color:white;font-size:13px;font-weight:500;">Certified Engineers</p>
                            <p class="mb-0" style="color:#666;font-size:12px;">Verified professionals only</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                             style="width:40px;height:40px;background:rgba(239,159,39,.1);border:1px solid rgba(239,159,39,.2);">
                            <i class="bi bi-file-earmark-check" style="color:#EF9F27;"></i>
                        </div>
                        <div>
                            <p class="mb-0" style="color:white;font-size:13px;font-weight:500;">PDF Reports</p>
                            <p class="mb-0" style="color:#666;font-size:12px;">Detailed inspection docs</p>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="d-flex align-items-center justify-content-center rounded-circle flex-shrink-0"
                             style="width:40px;height:40px;background:rgba(239,159,39,.1);border:1px solid rgba(239,159,39,.2);">
                            <i class="bi bi-chat-dots" style="color:#EF9F27;"></i>
                        </div>
                        <div>
                            <p class="mb-0" style="color:white;font-size:13px;font-weight:500;">Live Chat</p>
                            <p class="mb-0" style="color:#666;font-size:12px;">Direct engineer communication</p>
                        </div>
                    </div>
                </div>
                <div class="mt-5 pt-3" style="border-top:1px solid #222;">
                    <p style="color:#555;font-size:12px;">"Buy your property with confidence — know before you sign."</p>
                </div>
            </div>

            <!-- Right — Register Form -->
            <div class="col-md-7 p-5"
                 style="background:#111;border:1px solid #222;border-left:1px solid #1a1a1a;border-radius:0 16px 16px 0;">
                <div class="mb-4">
                    <h3 class="fw-bold mb-1" style="color:white;">Create Account</h3>
                    <p style="color:#666;font-size:14px;">Join PropCheck and inspect before you invest</p>
                </div>

                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Input.FullName" class="form-label">Full Name</label>
                        <input asp-for="Input.FullName" class="form-control" placeholder="John Doe" />
                        <span asp-validation-for="Input.FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Role" class="form-label">Register as</label>
                        <select asp-for="Input.Role" class="form-select">
                            <option value="Client">Client — I want to inspect a property</option>
                            <option value="Engineer">Engineer — I provide inspection services</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <input asp-for="Input.Email" class="form-control" autocomplete="username"
                               placeholder="name@example.com" />
                        <span asp-validation-for="Input.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <input asp-for="Input.Password" class="form-control" autocomplete="new-password"
                               placeholder="••••••••" />
                        <span asp-validation-for="Input.Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password"
                               placeholder="••••••••" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="w-100 btn btn-primary btn-lg mb-3">
                        Create Account
                    </button>

                    <p class="text-center mb-0" style="color:#666;font-size:13px;">
                        Already have an account?
                        <a asp-page="./Login" style="color:#EF9F27;text-decoration:none;">Sign in</a>
                    </p>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
